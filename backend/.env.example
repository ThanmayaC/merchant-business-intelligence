# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored and must never be committed.

APP_ENV=development

# PostgreSQL connection (created in Step 4). Format: user:password@host:port/database
DATABASE_URL=postgresql+psycopg://mbi_app:CHANGE_ME@localhost:5432/merchant_bi

# Ollama (Step 7). Pull the chat model once with:  ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b

# Sentence-Transformers embedding model for meaning-based search (downloads once, ~90 MB)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
