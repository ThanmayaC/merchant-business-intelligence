# Copy this file to .env (same folder) and fill in real values.
# .env is git-ignored and must never be committed.

APP_ENV=development

# PostgreSQL connection (we'll create this user and database in Step 4)
DATABASE_URL=postgresql+psycopg://mbi_app:CHANGE_ME@localhost:5432/merchant_bi

# Ollama (models chosen in Step 7)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=